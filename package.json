{
  "name": "places",
  "version": "0.0.2",
  "description": "Create interactive maps with markers, tracks, overlays, image alignment, heatmaps, VaultQuery data, CSV and GPX imports, custom styling, charts, search, directions, and provider extensions.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src package.json manifest.json versions.json",
    "rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
    "generate-help": "md-to-obsidian-dom ./help-md ./src/generated-help --prefix places-help --grammar ./help-grammar.mjs && md-to-obsidian-dom ./help-md/generated-snippets ./src/generated-help/snippets --prefix places-help --grammar ./help-grammar.mjs && node -e \"const fs=require('fs'),p=require('path'),walk=d=>fs.readdirSync(d,{withFileTypes:true}).forEach(e=>{const fp=p.join(d,e.name);if(e.isDirectory())walk(fp);else if(e.name.endsWith('.generated.ts')){const c=fs.readFileSync(fp,'utf8');if(!c.startsWith('// @ts-nocheck'))fs.writeFileSync(fp,'// @ts-nocheck\\n'+c)}});walk('./src/generated-help')\"",
    "dev": "npm run dev:core && npm run dev:plugin",
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "format": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo . --fix",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "watch": "npm run dev:core && npm run generate-help && node esbuild.config.mjs watch",
    "bundle": "npm run build:core && npm run bundle:plugin",
    "build:core": "tsc -p tsconfig.core.json && node esbuild.core.mjs production",
    "dev:core": "tsc -p tsconfig.core.json && node esbuild.core.mjs",
    "watch:core": "node esbuild.core.mjs watch",
    "prepare": "node --input-type=module -e \"import { hasBuiltExports } from './esbuild.library.mjs'; process.exit(hasBuiltExports() ? 0 : 1)\" || npm run bundle",
    "bundle:plugin": "npm run generate-help && node esbuild.config.mjs production && npm run rename",
    "dev:plugin": "npm run generate-help && node esbuild.config.mjs && npm run rename",
    "format:check": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo ."
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@types/color-name": "1.1.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "md-to-obsidian-dom": "git+https://github.com/bobstanton/md-to-obsidian-dom.git#ac1da9e441ae5830780706a773863648e8718dfa",
    "obsidian": "1.14.4",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vaultquery": "git+https://github.com/bobstanton/vaultquery.git#1.2.3"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "fastest-levenshtein": "^1.0.16",
    "obsidian-debug-logger": "git+https://github.com/bobstanton/obsidian-debug-logger.git#e9cd205ae8da09db33b4c758488ec8200323d370",
    "placeholder-resolver": "git+https://github.com/bobstanton/placeholder-resolver.git#3ed9fc1ae04e27681788906046065f1cb7112c4f",
    "places-shared": "git+https://github.com/bobstanton/places-shared.git#0.0.2",
    "user-template-renderer": "git+https://github.com/bobstanton/user-template-renderer.git#f61e96e040845fa5178e6ef67ff0f3bf224047b4",
    "@types/geojson": "^7946.0.16",
    "color-name": "1.1.4"
  },
  "overrides": {
    "typescript": "6.0.3",
    "obsidian": "1.14.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs",
      "default": "./dist/core/index.js"
    },
    "./core/strategies": {
      "types": "./dist/core/strategies/index.d.ts",
      "import": "./dist/core/strategies/index.js",
      "require": "./dist/core/strategies.cjs",
      "default": "./dist/core/strategies/index.js"
    },
    "./core/charts": {
      "types": "./dist/core/charts/index.d.ts",
      "import": "./dist/core/charts/index.js",
      "require": "./dist/core/charts.cjs",
      "default": "./dist/core/charts/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "main.js",
    "styles.css",
    "*.mjs",
    "*.json",
    "globals.d.ts"
  ]
}
