{
  "compilerOptions": {
    "noEmit": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "skipLibCheck": true,
    "paths": {
      "places/core": [
        "./src/core/index.ts"
      ],
      "places/core/charts": [
        "./src/core/charts/index.ts"
      ],
      "places/core/strategies": [
        "./src/core/strategies/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "./globals.d.ts"
  ]
}
